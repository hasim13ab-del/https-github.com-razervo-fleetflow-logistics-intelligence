rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation helper
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && getRole() == 'super_admin';
    }

    function isHubAdmin() {
      return isSignedIn() && getRole() == 'hub_admin';
    }

    function isSupervisor() {
      return isSignedIn() && getRole() == 'supervisor';
    }

    function isAdminOrAbove() {
      return isSignedIn() && (getRole() == 'super_admin' || getRole() == 'hub_admin' || getRole() == 'admin');
    }

    function isSupervisorOrAbove() {
      return isAdminOrAbove() || isSupervisor();
    }

    // User Profile collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isSuperAdmin();
      allow delete: if false; // Profiles shouldn't be deleted via client SDK
    }

    // Hubs collection
    match /hubs/{hubId} {
      allow read: if isSignedIn();
      allow create: if isSuperAdmin();
      allow update: if isAdminOrAbove();
      allow delete: if isSuperAdmin();
    }

    // Attendance collection
    match /attendance/{attId} {
      allow read: if isSignedIn();
      allow create: if isSupervisorOrAbove();
      allow update: if isSupervisorOrAbove();
      allow delete: if isSuperAdmin();
    }

    // KPI entries collection
    match /kpi/{kpiId} {
      allow read: if isSignedIn();
      allow create: if isSupervisorOrAbove();
      allow update: if isSupervisorOrAbove();
      allow delete: if isSuperAdmin();
    }

    // Shipments collection
    match /shipments/{shipmentId} {
      allow read: if isSignedIn();
      allow create: if isSupervisorOrAbove();
      allow update: if isSupervisorOrAbove();
      allow delete: if isSuperAdmin();
    }

    // System config
    match /system/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Notifications/Alerts
    match /alerts/{alertId} {
      allow read: if isSignedIn();
      allow create: if isSupervisorOrAbove();
      allow update: if isSupervisorOrAbove();
      allow delete: if isSuperAdmin();
    }
  }
}